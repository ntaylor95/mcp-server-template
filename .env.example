# -----------------------------------------------------------------------
# Azure AD / Microsoft 365
# -----------------------------------------------------------------------
# Your Azure AD tenant ID (find in Azure Portal > Azure Active Directory)
AZURE_TENANT_ID=

# App registration client ID (Azure Portal > App registrations)
# The app needs the "Sites.Read.All" delegated permission on Microsoft Graph.
AZURE_CLIENT_ID=

# Client secret — required only for AUTH_MODE=obo (production).
# Leave blank for local dev.
AZURE_CLIENT_SECRET=

# Authentication mode:
#   interactive   Browser pop-up; token cached locally.  (default, local dev)
#   device_code   Prints a URL + code for headless environments.
#   obo           On-Behalf-Of flow; requires AZURE_CLIENT_SECRET and a
#                 Bearer token in the Authorization header.   (production)
AUTH_MODE=interactive

# -----------------------------------------------------------------------
# Milvus
# -----------------------------------------------------------------------
# Absolute path to the Milvus Lite .db file produced by the ingestion pipeline.
MILVUS_DB_PATH=/path/to/milvus_document_store.db

# Collection name to search (must exist in the .db file).
# The server also looks for <MILVUS_COLLECTION>_questions if it exists.
MILVUS_COLLECTION=hr

# Must match the provider used when the DB was built.
# "pymilvus"   — local ONNX model, no key needed, dim=768
# "azure_openai" — Azure OpenAI, dim depends on deployment
EMBEDDING_PROVIDER=azure_openai

# Required when EMBEDDING_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embed3-small

# Azure OpenAI chat model (used to answer questions from document markdown)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-nano
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_MAX_TOKENS=1000

# -----------------------------------------------------------------------
# SharePoint
# -----------------------------------------------------------------------
SHAREPOINT_SITE_URL=https://tricentisgmbh.sharepoint.com/sites/Tricentis

# Path to the policy folder relative to the "Shared Documents" drive root.
# Do not URL-encode — spaces are fine here.
# Multiple folders can be supported by running ingestion against each path separately.
# POC default: Information Security and IT policies
SHAREPOINT_POLICIES_FOLDER=01 - Tricentis Policies/Information Security and IT Policies/01 - Current Information Security Policies
